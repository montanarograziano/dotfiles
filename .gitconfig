[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
	editor = vim
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[merge]
	conflictstyle = zdiff3
[pull]
	rebase = true
[fetch]
	prune = true
# Personal identity (name, email, GitHub handle, signing key) is kept in an
# untracked local file so it never gets committed. Copy
# git/local.gitconfig.example to ~/.config/git/local.gitconfig and edit it
# (install.sh does this automatically on first run). Missing includes are
# silently ignored by git.
[include]
	path = ~/.config/git/local.gitconfig
