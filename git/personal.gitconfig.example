# Personal git identity. Applied to repos under ~/.config (your dotfiles) via
# the includeIf rule in local.gitconfig. Copy to ~/.config/git/personal.gitconfig
# (install.sh does this) and fill in your details. Gitignored: never committed.
#
# Identity only. SSH keys are selected per host in ~/.ssh/config.
[user]
	name = your-personal-name
	email = you@personal.example
[github]
	user = your-github-handle
