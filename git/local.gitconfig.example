# Default git identity for this machine. Copy to ~/.config/git/local.gitconfig
# (install.sh does this on first run) and fill in your details. The local copy
# is gitignored, so your identity is never committed.
#
# On a work-only machine this default is your WORK account. The personal
# dotfiles repo at ~/.config overrides it via the includeIf rule below.
#
# This file sets IDENTITY only (name/email). SSH keys are selected per host in
# ~/.ssh/config, which keeps authentication separate from commit identity and
# lets different hosts use different keys. See the README for an example.
[user]
	name = Your Work Name
	email = you@company.com

# The personal dotfiles repo (~/.config) commits with your PERSONAL account
# instead of the work default above. Add more includeIf rules (e.g.
# gitdir:~/personal/) if you keep personal projects elsewhere.
[includeIf "gitdir:~/.config/"]
	path = ~/.config/git/personal.gitconfig
