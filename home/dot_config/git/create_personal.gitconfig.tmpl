# PERSONAL identity, applied under ~/workspace/personal/ and the dotfiles
# source at ~/.local/share/chezmoi/ (see ~/.gitconfig).
# Created once by chezmoi; edit freely, `chezmoi apply` will not overwrite it.
[user]
	name = {{ .personal.name }}
	email = {{ .personal.email }}
[github]
	user = {{ .personal.github }}
# SSH keys are selected per-host by ~/.ssh/config, not here.
